{
  "schemaVersion": 1,
  "id": "senshi",
  "familyID": "senshi",
  "name": "Senshi",
  "version": "1.0.0",
  "minimumAppVersion": "0.1.0",
  "contentType": "video",
  "language": "en",
  "contentRating": "unknown",
  "releaseTrack": "beta",
  "status": "active",
  "attribution": {
    "author": "Vireo compatibility experiment",
    "website": "https://senshi.live"
  },
  "authorization": {
    "basis": "owner-authorised",
    "note": "EXPERIMENT ONLY. Basis asserted by the project owner for a compatibility test; this is NOT a rights determination and this connector must not ship without documented authorisation from the source operator.",
    "evidenceURL": "https://senshi.live/"
  },
  "allowedHosts": [
    "senshi.live",
    "ninstream.com"
  ],
  "capabilities": [
    "discovery",
    "search",
    "details",
    "episodes",
    "streams"
  ],
  "limits": {
    "timeoutMilliseconds": 20000,
    "maxConcurrentRequests": 2,
    "maxResponseBytes": 8388608
  },
  "operations": {
    "discovery": {
      "sections": [
        {
          "id": "trending-week",
          "title": "Trending This Week",
          "request": {
            "method": "GET",
            "urlTemplate": "https://senshi.live/anime/trending/week",
            "headers": {
              "Accept": "application/json"
            }
          },
          "response": {
            "format": "json"
          },
          "items": {
            "collection": "[*]",
            "fields": {
              "sourceID": {
                "path": "id"
              },
              "title": {
                "path": "title_english",
                "fallbacks": [
                  {
                    "path": "title"
                  }
                ]
              },
              "posterURL": {
                "path": "anime_picture",
                "transforms": [
                  {
                    "op": "absolutize"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "search": {
      "request": {
        "method": "POST",
        "urlTemplate": "https://senshi.live/anime/filter",
        "headers": {
          "Accept": "application/json"
        },
        "body": "{\"searchTerm\":\"{query}\",\"page\":1,\"limit\":30}"
      },
      "response": {
        "format": "json"
      },
      "items": {
        "collection": "data[*]",
        "fields": {
          "sourceID": {
            "path": "id"
          },
          "title": {
            "path": "title_english",
            "fallbacks": [
              {
                "path": "title"
              }
            ]
          },
          "posterURL": {
            "path": "anime_picture",
            "transforms": [
              {
                "op": "absolutize"
              }
            ]
          }
        }
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://senshi.live/anime/{titleID}",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "format": "json"
      },
      "extract": {
        "title": {
          "path": "title_english",
          "fallbacks": [
            {
              "path": "title"
            }
          ]
        },
        "synopsis": {
          "path": "ani_description"
        },
        "posterURL": {
          "path": "anime_picture",
          "transforms": [
            {
              "op": "absolutize"
            }
          ]
        },
        "year": {
          "path": "ani_year"
        }
      }
    },
    "episodes": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://senshi.live/episodes/{titleID}",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "format": "json"
      },
      "extract": {
        "collection": "[*]",
        "fields": {
          "episodeID": {
            "path": "ep_id"
          },
          "title": {
            "path": "ep_title"
          },
          "episodeNumber": {
            "path": "ep_id"
          }
        }
      }
    },
    "streams": {
      "variants": ["sub", "dub"],
      "request": {
        "method": "GET",
        "urlTemplate": "https://senshi.live/episode-embeds/{titleID}/{episodeID}",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "format": "json"
      },
      "playbackHeaders": {
        "Referer": "https://senshi.live/",
        "Origin": "https://senshi.live"
      },
      "extract": {
        "collection": {
          "path": "[*]",
          "where": [
            {
              "path": "status",
              "containsPlaceholder": "variant"
            }
          ]
        },
        "fields": {
          "url": {
            "path": "url",
            "fallbacks": [
              {
                "path": "server2"
              },
              {
                "path": "serverFM"
              }
            ]
          }
        }
      }
    }
  },
  "releaseNotes": "Initial release. JSON API source: trending-week discovery (bare root array), POST /anime/filter search, details, episodes, and sub/dub stream variants selected by a containsPlaceholder filter on the row status (HardSub/Dub). A title with no Dub rows fails with the no-playable-stream state — never a silent sub fallback."
}
