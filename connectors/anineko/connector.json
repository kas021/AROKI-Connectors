{
  "schemaVersion": 1,
  "id": "anineko",
  "familyID": "anineko",
  "name": "AniNeko",
  "version": "1.1.0",
  "minimumAppVersion": "0.1.0",
  "contentType": "video",
  "language": "en",
  "contentRating": "unknown",
  "releaseTrack": "beta",
  "status": "active",
  "attribution": {
    "author": "Vireo compatibility experiment",
    "website": "https://anineko.to/"
  },
  "authorization": {
    "basis": "owner-authorised",
    "note": "EXPERIMENT ONLY. Basis asserted by the project owner for a compatibility test; this is NOT a rights determination and this connector must not ship without documented authorisation from the source operator.",
    "evidenceURL": "https://anineko.to/"
  },
  "allowedHosts": [
    "anineko.to",
    "cdn.anizara.store",
    "vivibebe.site"
  ],
  "capabilities": [
    "discovery",
    "search",
    "details",
    "episodes",
    "streams"
  ],
  "limits": {
    "timeoutMilliseconds": 20000,
    "maxConcurrentRequests": 2,
    "maxResponseBytes": 8388608
  },
  "operations": {
    "discovery": {
      "sections": [
        {
          "id": "featured",
          "title": "Featured Anime",
          "semantic": "popular",
          "request": {
            "method": "GET",
            "urlTemplate": "https://anineko.to/",
            "headers": {
              "Accept": "text/html",
              "Referer": "https://anineko.to/"
            }
          },
          "response": { "format": "html" },
          "items": {
            "collection": "div#nvFeaturedGrid article.nv-anime-card",
            "fields": {
              "sourceID": {
                "selector": "a.nv-anime-thumb",
                "part": "attr",
                "attr": "href",
                "transforms": [
                  { "op": "removePrefix", "value": "/watch/" }
                ]
              },
              "title": {
                "selector": "h3.nv-anime-title a",
                "part": "text",
                "transforms": [{ "op": "trim" }]
              },
              "posterURL": {
                "selector": "a.nv-anime-thumb img",
                "part": "attr",
                "attr": "src"
              }
            }
          }
        },
        {
          "id": "ongoing",
          "title": "Ongoing",
          "semantic": "recent",
          "request": {
            "method": "GET",
            "urlTemplate": "https://anineko.to/ongoing",
            "headers": {
              "Accept": "text/html",
              "Referer": "https://anineko.to/"
            }
          },
          "response": { "format": "html" },
          "items": {
            "collection": "article.nv-anime-card",
            "fields": {
              "sourceID": {
                "selector": "a.nv-anime-thumb",
                "part": "attr",
                "attr": "href",
                "transforms": [
                  { "op": "removePrefix", "value": "/watch/" }
                ]
              },
              "title": {
                "selector": "a.nv-anime-thumb img",
                "part": "attr",
                "attr": "alt",
                "transforms": [{ "op": "trim" }]
              },
              "posterURL": {
                "selector": "a.nv-anime-thumb img",
                "part": "attr",
                "attr": "src"
              }
            }
          }
        }
      ]
    },
    "search": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://anineko.to/ajax/search?q={query}",
        "headers": {
          "Accept": "application/json",
          "Referer": "https://anineko.to/"
        }
      },
      "response": { "format": "json" },
      "items": {
        "collection": "results[*]",
        "fields": {
          "sourceID": {
            "path": "url",
            "transforms": [
              { "op": "removePrefix", "value": "/watch/" }
            ]
          },
          "title": { "path": "title" },
          "posterURL": { "path": "image" }
        }
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://anineko.to/watch/{titleID}",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://anineko.to/"
        }
      },
      "response": { "format": "html" },
      "extract": {
        "title": {
          "selector": "h1",
          "part": "text",
          "transforms": [{ "op": "trim" }]
        },
        "synopsis": {
          "selector": "p.nv-info-desc",
          "part": "text",
          "transforms": [{ "op": "trim" }]
        },
        "posterURL": {
          "selector": "aside.nv-info-poster img",
          "part": "attr",
          "attr": "src"
        },
        "genres": {
          "collection": "div.nv-info-genres span"
        }
      }
    },
    "episodes": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://anineko.to/watch/{titleID}",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://anineko.to/"
        }
      },
      "response": { "format": "html" },
      "extract": {
        "collection": "article.nv-info-episode-item a.nv-info-episode-main",
        "fields": {
          "episodeID": {
            "selector": "strong",
            "part": "text",
            "transforms": [{ "op": "firstInteger" }]
          },
          "title": {
            "selector": "strong",
            "part": "text",
            "transforms": [{ "op": "trim" }]
          },
          "episodeNumber": {
            "selector": "strong",
            "part": "text",
            "transforms": [{ "op": "firstInteger" }]
          }
        }
      }
    },
    "streams": {
      "variants": ["sub", "dub"],
      "playbackHeaders": {
        "Referer": "https://vivibebe.site/",
        "Origin": "https://vivibebe.site",
        "User-Agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 Version/18.0 Mobile/15E148 Safari/604.1"
      },
      "request": {
        "method": "GET",
        "urlTemplate": "https://anineko.to/watch/{titleID}/ep-{episodeID}",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://anineko.to/"
        }
      },
      "response": { "format": "html" },
      "extract": {
        "collection": "html",
        "fields": {
   "url": {
    "selector": "div.lang-group[data-id*=\"{variant}\"] button.nv-server-btn.server-video.default",
    "part": "attr",
    "attr": "data-video",
            "transforms": [
              { "op": "removePrefix", "value": "https://vivibebe.site/" },
              {
                "op": "template",
                "value": "https://vivibebe.site/public/stream/{value}/master.m3u8"
              },
              {
                "op": "replaceFirst",
                "find": "?sub=",
                "with": "/master.m3u8?sub="
              }
            ]
          },
   "qualityLabel": {
    "selector": "div.lang-group[data-id*=\"{variant}\"] button.nv-server-btn.server-video.default",
    "part": "text",
            "transforms": [{ "op": "trim" }]
          }
        }
      }
    }
  },
  "releaseNotes": "M20 fixes late-series playback: some episode pages (e.g. Naruto ep 220) embed the subtitle into the server button's data-video ('?sub=' query), and the site rotates which server buttons are served per request. The constructed URL used to put the query before /master.m3u8, which 301-redirected to a non-HTTPS address the engine's policy rejects. The url transform now moves '?sub=' after /master.m3u8 (the server serves the same master either way), so both the clean and the subtitle-embedded vivibebe buttons produce a playable playlist regardless of rotation."
}
