  "allowedHosts": [
    "anikototv.to",
    "anikoto.cz",
    "cdn.anipixcdn.co",
    "vidtube.site",
    "megaplay.buzz",
    "*.kotocdn.site",
    "vidtub.norami.top",
    "cdn.watching.onl",
    "vidtub.shiora.site",
