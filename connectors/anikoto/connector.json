{
  "schemaVersion": 1,
  "id": "anikoto",
  "familyID": "anikoto",
  "name": "AniKoto",
  "version": "0.3.5",
  "minimumAppVersion": "0.1.0",
  "contentType": "video",
  "language": "en",
  "contentRating": "unknown",
  "releaseTrack": "beta",
  "status": "active",
  "attribution": {
    "author": "Vireo compatibility experiment",
    "website": "https://anikototv.to"
