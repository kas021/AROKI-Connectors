          "response": {
            "format": "html"
          },
          "pagination": {
            "type": "pageParam",
            "start": 1,
            "maxPages": 25
          },
          "items": {
            "collection": "#list-items div.item",
            "fields": {
              "sourceID": {
                "selector": "a.name.d-title",
                "part": "attr",
                "attr": "href",
                "transforms": [
                  {
                    "op": "removePrefix",
                    "value": "https://anikototv.to/watch/"
                  },
                  {
                    "op": "removeSuffix",
                    "value": "/ep-1"
