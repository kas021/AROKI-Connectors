        {
          "id": "sci-fi",
          "title": "Sci-Fi",
          "semantic": "genre",
          "request": {
            "method": "GET",
            "urlTemplate": "https://anikototv.to/genre/sci-fi?page={page}",
            "headers": { "Accept": "text/html", "Referer": "https://anikototv.to/" }
          },
          "response": { "format": "html" },
          "pagination": { "type": "pageParam", "start": 1, "maxPages": 25 },
          "items": {
            "collection": "#list-items div.item",
            "fields": {
              "sourceID": {
                "selector": "a.name.d-title", "part": "attr", "attr": "href",
                "transforms": [
                  { "op": "removePrefix", "value": "https://anikototv.to/watch/" },
                  { "op": "removeSuffix", "value": "/ep-1" }
                ]
              },
              "title": { "selector": "a.name.d-title", "part": "text", "transforms": [{ "op": "trim" }] },
              "posterURL": { "selector": "div.poster img", "part": "attr", "attr": "src" }
            }
          }
        }
      ]
    },
    "search": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://anikototv.to/filter?keyword={query}&page={page}",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://anikototv.to/"
        }
      },
      "response": {
        "format": "html"
      },
      "items": {
        "collection": "#list-items div.item",
        "fields": {
          "sourceID": {
            "selector": "a.name.d-title",
            "part": "attr",
            "attr": "href",
            "transforms": [
              {
                "op": "removePrefix",
                "value": "https://anikototv.to/watch/"
              },
              {
                "op": "removeSuffix",
                "value": "/ep-1"
              }
            ]
          },
          "title": {
            "selector": "a.name.d-title",
            "part": "text",
            "transforms": [
              {
                "op": "trim"
              }
            ]
          },
          "posterURL": {
            "selector": "div.poster img",
            "part": "attr",
            "attr": "src"
          }
        }
      },
      "pagination": {
        "type": "pageParam",
        "start": 1,
        "maxPages": 10
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://anikototv.to/watch/{titleID}",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://anikototv.to/"
        }
      },
      "response": {
        "format": "html"
      },
      "extract": {
        "sharedID": {
          "selector": "#watch-main",
          "part": "attr",
          "attr": "data-id"
        },
        "title": {
          "selector": "h1.d-title",
          "part": "text",
          "transforms": [
            {
              "op": "trim"
            }
          ]
        },
        "synopsis": {
          "selector": "div.synopsis div.shorting",
          "part": "text",
          "transforms": [
            {
              "op": "trim"
            }
          ]
        },
        "posterURL": {
          "selector": "div.poster img",
          "part": "attr",
          "attr": "src"
        },
        "genres": {
          "collection": "div.bmeta div.meta a[href*=\"/genre/\"]"
        }
      }
    },
    "episodes": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://anikototv.to/ajax/episode/list/{sharedID}",
        "headers": {
          "Accept": "application/json, text/plain, */*",
          "X-Requested-With": "XMLHttpRequest",
          "Referer": "https://anikototv.to/"
        }
      },
      "response": {
        "format": "json-wrapped-html",
        "unwrapPath": "result"
      },
      "extract": {
        "collection": ".episodes ul.ep-range li",
        "fields": {
          "episodeID": {
            "selector": "a",
            "part": "attr",
            "attr": "data-ids"
          },
          "title": {
            "selector": "span.d-title",
            "part": "text"
          },
          "episodeNumber": {
            "selector": "a",
            "part": "attr",
            "attr": "data-num",
            "transforms": [
              {
                "op": "firstInteger"
              }
            ]
          },
          "availableVariants": {
            "collection": ".dropdown.filter.type div.dropdown-item[data-value=\"sub\"], .dropdown.filter.type div.dropdown-item[data-value=\"dub\"]",
            "transforms": [
              {
                "op": "lowercased"
              },
              {
                "op": "replaceFirst",
                "find": "only ",
                "with": ""
              },
              {
                "op": "trim"
              }
            ]
          }
        }
      }
    },
    "streams": {
      "finalMediaPolicy": "public-https",
      "variants": ["sub", "dub"],
      "playbackHeaders": {
        "Referer": "https://megaplay.buzz/"
      },
      "steps": [
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://anikototv.to/ajax/server/list?servers={episodeID}",
            "headers": {
              "Accept": "application/json, text/plain, */*",
              "X-Requested-With": "XMLHttpRequest",
              "Referer": "https://anikototv.to/"
            }
          },
          "response": {
            "format": "json-wrapped-html",
            "unwrapPath": "result"
          },
          "extract": {
            "context": {
              "linkID": {
                "selector": "div.type[data-type=\"{variant}\"] li[data-sv-id=\"8e4\"]",
                "part": "attr",
                "attr": "data-link-id",
                "fallbacks": [
                  {
                    "selector": "div.type[data-type=\"{variant}\"] li[data-sv-id=\"323\"]",
                    "part": "attr",
                    "attr": "data-link-id"
                  },
                  {
                    "selector": "div.type[data-type=\"{variant}\"] li[data-sv-id=\"e54\"]",
                    "part": "attr",
                    "attr": "data-link-id"
                  }
                ]
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://anikototv.to/ajax/server?get={linkID}",
            "headers": {
              "Accept": "application/json, text/plain, */*",
              "X-Requested-With": "XMLHttpRequest",
              "Referer": "https://anikototv.to/"
            }
          },
          "response": {
            "format": "json"
          },
          "extract": {
            "context": {
              "playerURL": {
                "path": "result.url",
                "kind": "url"
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "follow": "playerURL",
            "headers": {
              "Referer": "https://anikototv.to/",
              "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36"
            }
          },
          "response": {
            "format": "html"
          },
          "extract": {
            "context": {
              "playerID": {
                "selector": "[data-id]",
                "part": "attr",
                "attr": "data-id",
                "transforms": [
                  {
                    "op": "firstInteger"
                  }
                ]
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "originOf": "playerURL",
            "pathTemplate": "/stream/getSources?id={playerID}&type={variant}",
            "headers": {
              "Accept": "application/json, text/plain, */*",
              "X-Requested-With": "XMLHttpRequest"
            }
          },
          "response": {
            "format": "json"
          },
          "extract": {
            "collection": "sources",
            "fields": {
              "url": {
                "path": "file",
                "fallbacks": [
                  {
                    "path": "url"
                  }
                ]
              }
            },
            "subtitles": {
              "collection": "tracks[*]",
              "fields": {
                "url": {
                  "path": "file",
                  "fallbacks": [
                    { "path": "url" },
                    { "path": "src" }
                  ]
                },
                "label": {
                  "path": "label",
                  "fallbacks": [
                    { "path": "name" }
                  ]
                },
                "languageCode": {
                  "path": "srclang",
                  "fallbacks": [
                    { "path": "language" }
                  ]
                },
                "format": {
                  "path": "format"
                }
              }
            }
          }
        }
      ]
    }
  },
  "releaseNotes": "M24 updates the native playback Referer for the current AniKoto player host after a One Piece episode-one live probe. The bounded four-step graph and final HTTPS media policy remain unchanged."
}
