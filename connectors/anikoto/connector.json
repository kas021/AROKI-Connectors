        {
          "id": "most-watched",
          "title": "Most Watched",
          "semantic": "popular",
          "request": {
            "method": "GET",
            "urlTemplate": "https://anikototv.to/filter?sort=most_watched&page={page}",
            "headers": {
              "Accept": "text/html",
              "Referer": "https://anikototv.to/"
            }
          },
          "response": {
            "format": "html"
          },
          "pagination": {
            "type": "pageParam",
            "start": 1,
            "maxPages": 25
          },
          "items": {
            "collection": "#list-items div.item",
            "fields": {
              "sourceID": {
                "selector": "a.name.d-title",
                "part": "attr",
                "attr": "href",
                "transforms": [
                  {
                    "op": "removePrefix",
                    "value": "https://anikototv.to/watch/"
                  },
                  {
                    "op": "removeSuffix",
                    "value": "/ep-1"
                  }
                ]
              },
              "title": {
                "selector": "a.name.d-title",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  }
                ]
              },
              "posterURL": {
                "selector": "div.poster img",
                "part": "attr",
                "attr": "src"
              }
            }
          }
        },
