    "search": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://anikototv.to/filter?keyword={query}&page={page}",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://anikototv.to/"
        }
      },
      "response": {
        "format": "html"
      },
      "items": {
        "collection": "#list-items div.item",
        "fields": {
          "sourceID": {
            "selector": "a.name.d-title",
            "part": "attr",
            "attr": "href",
            "transforms": [
              {
                "op": "removePrefix",
                "value": "https://anikototv.to/watch/"
              },
              {
                "op": "removeSuffix",
                "value": "/ep-1"
              }
            ]
          },
          "title": {
            "selector": "a.name.d-title",
            "part": "text",
            "transforms": [
              {
                "op": "trim"
              }
            ]
          },
          "posterURL": {
            "selector": "div.poster img",
            "part": "attr",
            "attr": "src"
          }
        }
      },
      "pagination": {
        "type": "pageParam",
        "start": 1,
        "maxPages": 10
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://anikototv.to/watch/{titleID}",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://anikototv.to/"
        }
      },
      "response": {
        "format": "html"
      },
      "extract": {
        "sharedID": {
          "selector": "#watch-main",
          "part": "attr",
          "attr": "data-id"
        },
        "title": {
          "selector": "h1.d-title",
          "part": "text",
          "transforms": [
            {
              "op": "trim"
            }
          ]
        },
        "synopsis": {
          "selector": "div.synopsis div.shorting",
          "part": "text",
          "transforms": [
            {
              "op": "trim"
            }
          ]
        },
        "posterURL": {
          "selector": "div.poster img",
          "part": "attr",
          "attr": "src"
        },
        "genres": {
          "collection": "div.bmeta div.meta a[href*=\"/genre/\"]"
        }
      }
    },
    "episodes": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://anikototv.to/ajax/episode/list/{sharedID}",
        "headers": {
          "Accept": "application/json, text/plain, */*",
          "X-Requested-With": "XMLHttpRequest",
          "Referer": "https://anikototv.to/"
        }
      },
      "response": {
        "format": "json-wrapped-html",
        "unwrapPath": "result"
      },
      "extract": {
        "collection": ".episodes ul.ep-range li",
        "fields": {
          "episodeID": {
            "selector": "a",
            "part": "attr",
            "attr": "data-ids"
          },
          "title": {
            "selector": "span.d-title",
            "part": "text"
          },
          "episodeNumber": {
            "selector": "a",
            "part": "attr",
            "attr": "data-num",
            "transforms": [
              {
                "op": "firstInteger"
              }
            ]
          },
          "availableVariants": {
            "collection": ".dropdown.filter.type div.dropdown-item[data-value=\"sub\"], .dropdown.filter.type div.dropdown-item[data-value=\"dub\"]",
            "transforms": [
              {
                "op": "lowercased"
              },
              {
                "op": "replaceFirst",
                "find": "only ",
                "with": ""
              },
              {
                "op": "trim"
              }
            ]
          }
        }
      }
    },
    "streams": {
      "variants": [
        "sub",
        "dub"
      ],
      "finalMediaPolicy": "public-https",
      "playbackHeaders": {
        "Referer": "https://anikage.cc/",
        "Origin": "https://anikage.cc",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36"
      },
      "steps": [
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://anikototv.to/watch/{titleID}",
            "headers": {
              "Accept": "text/html",
              "Referer": "https://anikototv.to/"
            }
          },
          "response": {
            "format": "html"
          },
          "extract": {
            "context": {
              "title": {
                "selector": "h1.title[data-jp]",
                "part": "attr",
                "attr": "data-jp",
                "fallbacks": [
                  {
                    "selector": "h1.title",
                    "part": "text"
                  }
                ]
              },
              "format": {
                "selector": "#w-info .bmeta .meta div:containsOwn(Type:) span",
                "part": "text",
                "transforms": [
                  {
                    "op": "replaceFirst",
                    "find": "Movie",
                    "with": "MOVIE"
                  },
                  {
                    "op": "replaceFirst",
                    "find": "Special",
                    "with": "SPECIAL"
                  },
                  {
                    "op": "replaceFirst",
                    "find": " Short",
                    "with": "_SHORT"
                  },
                  {
                    "op": "replaceFirst",
                    "find": "Music",
                    "with": "MUSIC"
                  }
                ]
              },
              "year": {
                "selector": "#w-info .bmeta .meta a[href*=year]",
                "part": "text",
                "transforms": [
                  {
                    "op": "firstInteger"
                  }
                ]
              },
              "season": {
                "selector": "#w-info .bmeta .meta a[href*=year]",
                "part": "text",
                "transforms": [
                  {
                    "op": "replaceFirst",
                    "find": " ",
                    "with": "&y="
                  },
                  {
                    "op": "template",
                    "value": "https://season.invalid/?s={value}"
                  },
                  {
                    "op": "queryValue",
                    "name": "s"
                  }
                ]
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://anikototv.to/ajax/server/list?servers={episodeID}",
            "headers": {
              "Accept": "application/json, text/plain, */*",
              "X-Requested-With": "XMLHttpRequest",
              "Referer": "https://anikototv.to/"
            }
          },
          "response": {
            "format": "json-wrapped-html",
            "unwrapPath": "result"
          },
          "extract": {
            "context": {
              "number": {
                "selector": ".tip b",
                "part": "text",
                "transforms": [
                  {
                    "op": "firstInteger"
                  }
                ]
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://anikage.cc/api/media/anime/browse?q={title}&format={format}&season={season}&yearMin={year}&yearMax={year}&page=1",
            "headers": {
              "Accept": "application/json, text/plain, */*",
              "Referer": "https://anikage.cc/",
              "Origin": "https://anikage.cc",
              "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36"
            }
          },
          "response": {
            "format": "json"
          },
          "extract": {
            "context": {
              "slug": {
                "path": "data[0].slug"
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://anikage.cc/api/media/anime/{slug}/episodes/{number}/sources?provider=koto&lang={variant}&refresh=1",
            "headers": {
              "Accept": "application/json, text/plain, */*",
              "Referer": "https://anikage.cc/",
              "Origin": "https://anikage.cc",
              "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36"
            }
          },
          "response": {
            "format": "json"
          },
          "extract": {
            "collection": "sources[*]",
            "fields": {
              "url": {
                "path": "url",
                "transforms": [
                  {
                    "op": "template",
                    "value": "https://og.bakayaro.live/{value}",
                    "encodeValue": false
                  }
                ]
              },
              "qualityLabel": {
                "path": "quality"
              },
              "mediaTypeHint": {
                "literal": "hls"
              }
            },
            "subtitles": {
              "collection": "subtitles[*]",
              "fields": {
                "url": {
                  "path": "file",
                  "transforms": [
                    {
                      "op": "template",
                      "value": "https://og.bakayaro.live/{value}",
                      "encodeValue": false
                    }
                  ]
                },
                "label": {
                  "path": "label"
                },
                "languageCode": {
                  "path": "srclang",
                  "fallbacks": [
                    {
                      "path": "language"
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  },
  "releaseNotes": "Restored in 0.3.10: AniKoto's own provider feed is now resolved through AniKage's public koto route (the direct MegaPlay responses became encrypted). Each title is matched by AniKoto's exact title, format, premiere season and year, and fails closed with no playable stream when that match is unavailable. Sub and Dub with all published caption languages."
}
