{
  "schemaVersion": 1,
  "id": "synthetiq-anime-direct",
  "familyID": "synthetiq-anime-direct",
  "name": "Synthetiq Flux",
  "version": "0.1.4",
  "minimumAppVersion": "2.0.38",
  "contentType": "video",
  "language": "en",
  "contentRating": "unknown",
  "releaseTrack": "beta",
  "status": "active",
  "attribution": {
    "author": "Synthetiq",
    "website": "https://github.com/kas021/Synthetiq-Modules"
  },
  "authorization": {
    "basis": "owner-authorised",
    "note": "Owner-authorised testing publication of the native port. No third-party media rights are supplied.",
    "evidenceURL": "https://github.com/kas021/Synthetiq-Modules"
  },
  "allowedHosts": [
    "graphql.anilist.co",
    "api.jikan.moe",
    "s4.anilist.co",
    "cdn.myanimelist.net",
    "vidhawk.buzz",
    "*.vidhawk.buzz",
    "raw.githubusercontent.com",
    "anikage.cc",
    "og.bakayaro.live",
    "*.bakayaro.live",
    "ani.pm",
    "embed.settlar.io",
    "media.settlar.io"
  ],
  "capabilities": [
    "discovery",
    "search",
    "details",
    "episodes",
    "streams"
  ],
  "requiredEngineFeatures": [
    "contextual-hls-v1",
    "numbered-catalogue-v1",
    "catalogue-fallback-v1",
    "graph-post-v1"
  ],
  "downloadSupport": "none",
  "limits": {
    "timeoutMilliseconds": 8000,
    "maxConcurrentRequests": 2,
    "maxResponseBytes": 2500000
  },
  "releaseNotes": "Restore native playback through AniPM/Settlar using canonical AniList identifiers. Existing MyAnimeList title IDs, saved shows and episode numbers are preserved. Playback session expiry and supplied captions are retained. Provider availability varies; downloads remain disabled. Requires Aroki 2.0.38 or newer.",
  "operations": {
    "discovery": {
      "sections": [
        {
          "id": "trending",
          "title": "Trending",
          "semantic": "custom",
          "request": {
            "method": "POST",
            "urlTemplate": "https://graphql.anilist.co",
            "headers": {
              "Accept": "application/json"
            },
            "body": "{\"query\":\"query{Page(page:{page},perPage:20){media(type:ANIME,sort:TRENDING_DESC,isAdult:false){id idMal title{english romaji} description(asHtml:false) coverImage{ large } seasonYear episodes status nextAiringEpisode{ episode }}}}\"}"
          },
          "response": {
            "format": "json"
          },
          "pagination": {
            "type": "pageParam",
            "start": 1,
            "maxPages": 25
          },
          "items": {
            "collection": "data.Page.media[*]",
            "fields": {
              "sourceID": {
                "path": "idMal"
              },
              "title": {
                "path": "title.english",
                "fallbacks": [
                  {
                    "path": "title.romaji"
                  }
                ]
              },
              "posterURL": {
                "path": "coverImage.large"
              }
            }
          }
        },
        {
          "id": "popular",
          "title": "Popular",
          "semantic": "popular",
          "request": {
            "method": "POST",
            "urlTemplate": "https://graphql.anilist.co",
            "headers": {
              "Accept": "application/json"
            },
            "body": "{\"query\":\"query{Page(page:{page},perPage:20){media(type:ANIME,sort:POPULARITY_DESC,isAdult:false){id idMal title{english romaji} description(asHtml:false) coverImage{ large } seasonYear episodes status nextAiringEpisode{ episode }}}}\"}"
          },
          "response": {
            "format": "json"
          },
          "pagination": {
            "type": "pageParam",
            "start": 1,
            "maxPages": 25
          },
          "items": {
            "collection": "data.Page.media[*]",
            "fields": {
              "sourceID": {
                "path": "idMal"
              },
              "title": {
                "path": "title.english",
                "fallbacks": [
                  {
                    "path": "title.romaji"
                  }
                ]
              },
              "posterURL": {
                "path": "coverImage.large"
              }
            }
          }
        }
      ]
    },
    "search": {
      "request": {
        "method": "POST",
        "urlTemplate": "https://graphql.anilist.co",
        "headers": {
          "Accept": "application/json"
        },
        "body": "{\"query\":\"query($q:String){Page(page:{page},perPage:20){media(search:$q,type:ANIME,sort:SEARCH_MATCH,isAdult:false){id idMal title{english romaji} description(asHtml:false) coverImage{ large } seasonYear episodes status nextAiringEpisode{ episode }}}}\",\"variables\":{\"q\":\"{query}\"}}"
      },
      "response": {
        "format": "json"
      },
      "pagination": {
        "type": "pageParam",
        "start": 1,
        "maxPages": 25
      },
      "items": {
        "collection": "data.Page.media[*]",
        "fields": {
          "sourceID": {
            "path": "idMal"
          },
          "title": {
            "path": "title.english",
            "fallbacks": [
              {
                "path": "title.romaji"
              }
            ]
          },
          "posterURL": {
            "path": "coverImage.large"
          }
        }
      }
    },
    "details": {
      "request": {
        "method": "POST",
        "urlTemplate": "https://graphql.anilist.co",
        "headers": {
          "Accept": "application/json"
        },
        "body": "{\"query\":\"query{Media(idMal:{titleID},type:ANIME){id idMal title{english romaji} description(asHtml:false) coverImage{ large } seasonYear episodes status nextAiringEpisode{ episode }}}\"}"
      },
      "response": {
        "format": "json"
      },
      "extract": {
        "title": {
          "path": "data.Media.title.english",
          "fallbacks": [
            {
              "path": "data.Media.title.romaji"
            }
          ]
        },
        "synopsis": {
          "path": "data.Media.description"
        },
        "posterURL": {
          "path": "data.Media.coverImage.large"
        },
        "sharedID": {
          "path": "data.Media.id"
        },
        "year": {
          "path": "data.Media.seasonYear"
        }
      }
    },
    "episodes": {
      "request": {
        "method": "POST",
        "urlTemplate": "https://graphql.anilist.co",
        "headers": {
          "Accept": "application/json"
        },
        "body": "{\"query\":\"query{Media(idMal:{titleID},type:ANIME){id idMal title{english romaji} description(asHtml:false) coverImage{ large } seasonYear episodes status nextAiringEpisode{ episode }}}\"}"
      },
      "response": {
        "format": "json"
      },
      "numberedRange": {
        "countPath": "data.Media.episodes",
        "nextEpisodePath": "data.Media.nextAiringEpisode.episode",
        "statusPath": "data.Media.status",
        "allowedStatuses": [
          "FINISHED",
          "RELEASING"
        ],
        "identityPath": "data.Media.idMal"
      },
      "extract": {
        "collection": "data.episodes[*]",
        "fields": {
          "episodeID": {
            "path": "id"
          }
        }
      }
    },
    "streams": {
      "variants": [
        "sub",
        "dub"
      ],
      "playbackHeaders": {
        "Referer": "https://embed.settlar.io/",
        "Origin": "https://embed.settlar.io"
      },
      "steps": [
        {
          "request": {
            "method": "POST",
            "urlTemplate": "https://graphql.anilist.co",
            "headers": {
              "Accept": "application/json"
            },
            "body": "{\"query\":\"query{Media(idMal:{titleID},type:ANIME){ id }}\"}"
          },
          "response": {
            "format": "json"
          },
          "extract": {
            "context": {
              "anilist": {
                "path": "data.Media.id"
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://ani.pm/api/anime/playback-bootstrap/anilist/{anilist}?ep={episodeID}&lang={variant}&backup=0",
            "headers": {
              "Accept": "application/json"
            }
          },
          "response": {
            "format": "json"
          },
          "extract": {
            "context": {
              "selection": {
                "path": "settlarSelection"
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://ani.pm/api/anime/settlar/session?selection={selection}&provider=anipm&ep={episodeID}&channel={variant}&telemetry=0",
            "headers": {
              "Accept": "application/json"
            }
          },
          "response": {
            "format": "json"
          },
          "extract": {
            "context": {
              "token": {
                "path": "embedUrl",
                "transforms": [
                  {
                    "op": "queryValue",
                    "name": "t"
                  }
                ]
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://embed.settlar.io/api/embed/session?t={token}",
            "headers": {
              "Accept": "application/json",
              "Referer": "https://embed.settlar.io/",
              "Origin": "https://embed.settlar.io"
            }
          },
          "response": {
            "format": "json"
          },
          "extract": {
            "collection": "@",
            "fields": {
              "url": {
                "path": "source"
              },
              "mediaTypeHint": {
                "path": "kind"
              },
              "qualityLabel": {
                "literal": "Auto"
              },
              "expiresAtEpochSeconds": {
                "path": "expiresAt"
              }
            },
            "subtitles": {
              "collection": "subtitles[*]",
              "fields": {
                "url": {
                  "path": "url"
                },
                "label": {
                  "path": "label",
                  "fallbacks": [
                    {
                      "path": "name"
                    }
                  ]
                },
                "languageCode": {
                  "path": "srclang",
                  "fallbacks": [
                    {
                      "path": "lang"
                    },
                    {
                      "path": "language"
                    }
                  ]
                },
                "format": {
                  "literal": "vtt"
                }
              }
            }
          }
        }
      ]
    }
  },
  "catalogueFallback": {
    "discovery": {
      "sections": [
        {
          "id": "popular",
          "title": "Popular",
          "semantic": "popular",
          "request": {
            "method": "GET",
            "urlTemplate": "https://api.jikan.moe/v4/top/anime?limit=20&page={page}",
            "headers": {
              "Accept": "application/json"
            }
          },
          "response": {
            "format": "json"
          },
          "items": {
            "collection": "data[*]",
            "fields": {
              "sourceID": {
                "path": "mal_id"
              },
              "title": {
                "path": "title_english",
                "fallbacks": [
                  {
                    "path": "title"
                  }
                ]
              },
              "posterURL": {
                "path": "images.jpg.large_image_url"
              }
            }
          },
          "pagination": {
            "type": "pageParam",
            "start": 1,
            "maxPages": 25
          }
        }
      ]
    },
    "search": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://api.jikan.moe/v4/anime?q={query}&page={page}&limit=20&sfw=true",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "format": "json"
      },
      "items": {
        "collection": "data[*]",
        "fields": {
          "sourceID": {
            "path": "mal_id"
          },
          "title": {
            "path": "title_english",
            "fallbacks": [
              {
                "path": "title"
              }
            ]
          },
          "posterURL": {
            "path": "images.jpg.large_image_url"
          }
        }
      },
      "pagination": {
        "type": "pageParam",
        "start": 1,
        "maxPages": 25
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://api.jikan.moe/v4/anime/{titleID}",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "format": "json"
      },
      "extract": {
        "title": {
          "path": "data.title_english",
          "fallbacks": [
            {
              "path": "data.title"
            }
          ]
        },
        "synopsis": {
          "path": "data.synopsis"
        },
        "posterURL": {
          "path": "data.images.jpg.large_image_url"
        },
        "year": {
          "path": "data.year"
        }
      }
    },
    "episodes": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://api.jikan.moe/v4/anime/{titleID}",
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "format": "json"
      },
      "extract": {
        "collection": "data.episodesList[*]",
        "fields": {
          "episodeID": {
            "path": "id"
          }
        }
      },
      "numberedRange": {
        "countPath": "data.episodes",
        "statusPath": "data.status",
        "allowedStatuses": [
          "Finished Airing"
        ],
        "identityPath": "data.mal_id"
      }
    }
  }
}
