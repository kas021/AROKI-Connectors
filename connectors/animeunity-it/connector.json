                  }
                }
              }
            },
            {
              "request": {
                "method": "GET",
                "follow": "embed",
                "headers": {
                  "Accept": "text/html",
                  "Referer": "https://animeunity.cx/"
                }
              },
              "response": {
                "format": "literal-selection",
                "scriptSelector": "script:containsData(window.masterPlaylist)",
                "selection": {
                  "kind": "assignment",
                  "name": "window.masterPlaylist",
                  "lineTerminatedAssignment": true
                }
              },
              "extract": {
                "collection": "@",
                "fields": {
                  "url": {
                    "path": "value.url",
                    "transforms": [
                      {
                        "op": "appendQuery",
                        "items": {
                          "token": "{token}",
                          "expires": "{expires}",
                          "h": "1"
                        }
                      }
                    ]
                  },
                  "mediaTypeHint": {
