{
  "schemaVersion": 1,
  "id": "onepace",
  "familyID": "onepace",
  "name": "One Pace",
  "version": "2.2.1",
  "minimumAppVersion": "0.1.0",
  "contentType": "video",
  "language": "en",
  "contentRating": "unknown",
  "releaseTrack": "stable",
  "status": "active",
  "attribution": {
    "author": "Vireo Migration",
    "website": "https://onepace.net"
  },
  "authorization": {
    "basis": "owner-authorised",
    "note": "Authorised by operator",
    "evidenceURL": "https://onepace.net"
  },
  "allowedHosts": [
    "onepace.net",
    "www.onepace.net",
    "pixeldrain.net",
    "pixeldrain.com"
  ],
  "capabilities": [
    "discovery",
    "search",
    "details",
    "episodes",
    "streams"
  ],
  "limits": {
    "timeoutMilliseconds": 30000,
    "maxConcurrentRequests": 4,
    "maxResponseBytes": 8388608
  },
  "operations": {
    "discovery": {
      "sections": [
        {
          "id": "one-pace",
          "title": "One Piece (One Pace)",
          "semantic": "all",
          "request": {
            "method": "GET",
            "urlTemplate": "https://onepace.net/en/watch"
          },
          "response": {
            "format": "html"
          },
          "items": {
            "collection": {
              "selector": "main"
            },
            "fields": {
              "sourceID": {
                "literal": "one-pace"
              },
              "title": {
                "literal": "One Piece (One Pace)"
              },
              "posterURL": {
                "selector": "img",
                "part": "attr",
                "attr": "src",
                "transforms": [
                  {
                    "op": "absolutize"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "search": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://onepace.net/en/watch?q={query}"
      },
      "response": {
        "format": "html"
      },
      "items": {
        "collection": {
          "selector": "main",
          "where": [
            {
              "field": "title",
              "containsPlaceholder": "query"
            }
          ]
        },
        "fields": {
          "sourceID": {
            "literal": "one-pace"
          },
          "title": {
            "literal": "One Piece (One Pace)"
          },
          "posterURL": {
            "selector": "img",
            "part": "attr",
            "attr": "src",
            "transforms": [
              {
                "op": "absolutize"
              }
            ]
          }
        }
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://onepace.net/en/watch?titleID={titleID}"
      },
      "response": {
        "format": "html"
      },
      "extract": {
        "title": {
          "selector": "title",
          "part": "text",
          "transforms": [
            {
              "op": "removeSuffix",
              "value": " — The Definitive One Piece Viewing Experience"
            },
            {
              "op": "trim"
            }
          ]
        },
        "synopsis": {
          "selector": "meta[name=description]",
          "part": "attr",
          "attr": "content"
        },
        "posterURL": {
          "selector": "meta[property=og:image][content*=.png]",
          "part": "attr",
          "attr": "content",
          "transforms": [
            {
              "op": "absolutize"
            }
          ]
        }
      }
    },
    "episodes": {
      "aggregation": {
        "index": {
          "request": {
            "method": "GET",
            "urlTemplate": "https://onepace.net/en/watch"
          },
          "response": {
            "format": "html"
          },
          "extract": {
            "collection": {
              "selector": "a[href*=\"pixeldrain.net/l/\"]"
            },
            "fields": {
              "listURL": {
                "selector": "a[href*=\"pixeldrain.net/l/\"]",
                "part": "attr",
                "attr": "href",
                "transforms": [
                  {
                    "op": "replaceFirst",
                    "find": "https://pixeldrain.net/l/",
                    "with": "https://pixeldrain.com/api/list/"
                  }
                ]
              }
            }
          }
        },
        "lists": {
          "response": {
            "format": "json"
          },
          "listVariant": {
            "path": "title",
            "transforms": [
              {
                "op": "lowercased"
              }
            ]
          },
          "extract": {
            "collection": "files[*]",
            "fields": {
              "episodeID": {
                "path": "id"
              },
              "groupingKey": {
                "path": "name",
                "transforms": [
                  {
                    "op": "removeSuffix",
                    "value": ".mp4"
                  },
                  {
                    "op": "removeBracketedSegments"
                  },
                  {
                    "op": "trim"
                  },
                  {
                    "op": "lowercased"
                  }
                ]
              },
              "title": {
                "path": "name",
                "transforms": [
                  {
                    "op": "removeSuffix",
                    "value": ".mp4"
                  },
                  {
                    "op": "removeBracketedSegments"
                  },
                  {
                    "op": "trim"
                  }
                ]
              },
              "thumbnailURL": {
                "path": "thumbnail_href",
                "transforms": [
                  {
                    "op": "absolutize"
                  }
                ]
              },
              "fileVariant": {
                "path": "name",
                "transforms": [
                  {
                    "op": "lowercased"
                  }
                ]
              },
              "streamURL": {
                "path": "id",
                "transforms": [
                  {
                    "op": "template",
                    "value": "https://pixeldrain.com/api/file/{value}"
                  }
                ]
              },
              "mediaTypeHint": {
                "literal": "auto"
              }
            }
          }
        },
        "playbackHeaders": {
          "Referer": "https://pixeldrain.com/"
        },
        "limits": {
          "maxLists": 200,
          "maxEpisodes": 2000,
          "maxTotalResponseBytes": 67108864,
          "flattenToSingleSeason": true
        }
      }
    }
  },
  "releaseNotes": "M25: Consolidates One Pace into a single stable title on discovery and search. Increases concurrency to 4 workers and raises timeout to 30s so all 485+ episodes across all arcs load smoothly."
}
