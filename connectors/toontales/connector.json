{
  "schemaVersion": 1,
  "id": "toontales",
  "familyID": "toontales",
  "name": "ToonTales",
  "version": "1.0.1",
  "minimumAppVersion": "0.1.0",
  "contentType": "video",
  "language": "en",
  "contentRating": "unknown",
  "releaseTrack": "stable",
  "status": "active",
  "attribution": {
    "author": "Vireo Migration",
    "website": "https://www.toontales.net"
  },
  "authorization": {
    "basis": "owner-authorised",
    "note": "Authorised by operator",
    "evidenceURL": "https://www.toontales.net"
  },
  "allowedHosts": [
    "www.toontales.net",
    "ww.toontales.net"
  ],
  "capabilities": [
    "search",
    "details",
    "episodes",
    "streams"
  ],
  "limits": {
    "timeoutMilliseconds": 15000,
    "maxConcurrentRequests": 2,
    "maxResponseBytes": 8388608
  },
  "operations": {
    "search": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.toontales.net/?s={query}"
      },
      "response": {
        "format": "html"
      },
      "items": {
        "collection": "article[class*=\"post-\"]",
        "fields": {
          "sourceID": {
            "selector": "a[href*=\"/short/\"]",
            "part": "attr",
            "attr": "href",
            "transforms": [
              {
                "op": "removePrefix",
                "value": "https://www.toontales.net/short/"
              },
              {
                "op": "removeSuffix",
                "value": "/"
              }
            ]
          },
          "title": {
            "selector": "h3.title",
            "part": "text",
            "transforms": [
              {
                "op": "trim"
              }
            ]
          },
          "posterURL": {
            "selector": "img",
            "part": "attr",
            "attr": "src"
          }
        }
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.toontales.net/short/{titleID}/"
      },
      "response": {
        "format": "html"
      },
      "extract": {
        "title": {
          "selector": "meta[property=\"og:title\"]",
          "part": "attr",
          "attr": "content",
          "transforms": [
            {
              "op": "trim"
            }
          ]
        },
        "synopsis": {
          "selector": "meta[property=\"og:description\"]",
          "part": "attr",
          "attr": "content"
        },
        "posterURL": {
          "selector": "meta[property=\"og:image\"]",
          "part": "attr",
          "attr": "content"
        }
      }
    },
    "episodes": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.toontales.net/short/{titleID}/"
      },
      "response": {
        "format": "html"
      },
      "extract": {
        "collection": "html",
        "fields": {
          "episodeID": {
            "selector": "meta[property=\"og:url\"]",
            "part": "attr",
            "attr": "content",
            "transforms": [
              {
                "op": "removePrefix",
                "value": "https://www.toontales.net/short/"
              },
              {
                "op": "removeSuffix",
                "value": "/"
              }
            ]
          },
          "title": {
            "selector": "meta[property=\"og:title\"]",
            "part": "attr",
            "attr": "content",
            "transforms": [
              {
                "op": "trim"
              }
            ]
          }
        }
      }
    },
    "streams": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.toontales.net/short/{episodeID}/"
      },
      "response": {
        "format": "html-embedded-json",
        "scriptSelector": "script[type=\"application/ld+json\"]"
      },
      "playbackHeaders": {
        "Referer": "https://www.toontales.net/"
      },
      "extract": {
        "collection": {
          "path": "@graph[*]",
          "where": [
            {
              "path": "@type",
              "equals": "VideoObject"
            }
          ]
        },
        "fields": {
          "url": {
            "path": "contentUrl"
          }
        }
      }
    }
  },
  "releaseNotes": "Streams fix: short pages no longer carry a <video><source> element; the direct MP4 now comes from the Yoast JSON-LD block (html-embedded-json, VideoObject.contentUrl on the ww.toontales.net media host)."
}
